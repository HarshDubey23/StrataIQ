# ---------- Backend (FastAPI) ----------
# PostgreSQL with PostGIS. Neon / Supabase / Render URLs work (postgres:// is accepted).
DATABASE_URL=postgresql://strataiq:strataiq@localhost:5432/strataiq
# Long random string. REQUIRED in production (APP_ENV=production refuses the dev default).
JWT_SECRET=change-me-to-a-long-random-string
APP_ENV=development
# US or IN. Also set NEXT_PUBLIC_MARKET to the same value on the frontend.
MARKET=US
# Long random string, the same on API and frontend. REQUIRED in production.
PROXY_SECRET=
# true when served over HTTPS
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API directly (the Next.js proxy does not need this)
CORS_ORIGINS=http://localhost:3000
# Identifies the app to OpenStreetMap services (Nominatim usage policy asks for contact info)
CONTACT_EMAIL=
# Optional: travel-time catchments (free key at https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
# Optional: AI category mapping and plain-language explanations
AI_API_KEY=
AI_API_URL=
AI_MODEL=
# A version header your AI provider requires, as name: value
AI_EXTRA_HEADER=
# Optional overrides
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# WORLDPOP_YEAR=2026        # default: this year (2015-2030 available)
# WORLDPOP_API_KEY=          # optional, raises the 1,000 requests/day anonymous limit
# MC_DRAWS=800

# ---------- Frontend (Next.js) ----------
# Server-side URL of the FastAPI backend; the browser only talks to /api on the frontend origin.
API_URL=http://localhost:8000
