FROM node:22-alpine AS build
WORKDIR /srv/web
ARG API_URL=http://api:8000
ARG NEXT_PUBLIC_MARKET=US
ARG NEXT_PUBLIC_CONTACT_EMAIL=
ARG NEXT_PUBLIC_PAYMENT_URL=
ARG NEXT_PUBLIC_VOICE=
ENV API_URL=$API_URL NEXT_PUBLIC_MARKET=$NEXT_PUBLIC_MARKET NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL NEXT_PUBLIC_PAYMENT_URL=$NEXT_PUBLIC_PAYMENT_URL NEXT_PUBLIC_VOICE=$NEXT_PUBLIC_VOICE NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:22-alpine
WORKDIR /srv/web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /srv/web ./
EXPOSE 3000
CMD ["npm", "start"]
