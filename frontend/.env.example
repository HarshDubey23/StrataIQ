# URL of the FastAPI backend (server-side only; the browser calls /api on this origin)
API_URL=http://localhost:8000
# US or IN, the same as the API's MARKET
NEXT_PUBLIC_MARKET=US
# Shown on legal pages, and where the full report button goes
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PAYMENT_URL=
# Same value as the API's PROXY_SECRET, server-side only (never NEXT_PUBLIC_)
PROXY_SECRET=
